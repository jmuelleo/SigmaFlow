# 7C8Q_DSG -- Moden der Posenverteilung, NFE 25
# Clusterschwelle 2.0 A, hoechstens 6 farbige Moden je Zelle.
#
#   gelb, dick   Kristallpose
#   farbig       je Modus eine Farbe; duenne Linien = alle Posen,
#                mitteldicke Sticks = Medoid des Modus
#   grau         alle uebrigen, kleinen Moden zusammen
#
# Objektnamen: <zelle>_m<i>_n<anzahl>[_TRIFFT]

bg_color white
set ray_opaque_background, 0
set orthoscopic, 1
set line_width, 0.8

