# TRAININGSHORIZONT FUER DEN KURATIERTEN DATENSATZ, 96 STUNDEN.
#
# HERKUNFT -- UND WARUM SIE SCHWAECHER IST ALS DIE VON final_horizon.env
#   final_horizon.env stammt aus GEMESSENEN Stufe-2-Durchsatzlaeufen
#   (Jobs 8628662/8628663). Diese Datei nicht: sie ist ABGELEITET aus dem
#   Rezeptlauf 8691436, der 348 Epochen in 93,1 h auf 19.037 Beispielen
#   erreichte, also 3,74 Epochen/h beziehungsweise rund 71.200 Beispiele/h --
#   mit `pb_check: true`, also unter denselben Datenpfadkosten wie hier.
#
#   Bei effektiver Batch 32 statt 64 gibt es doppelt so viele
#   Optimiererschritte und damit etwas mehr Verwaltungsaufwand. Angesetzt sind
#   deshalb 65.000 Beispiele/h, also 91 % des gemessenen Werts:
#
#       96 h x 65.000 / 17.685 = 352 Epochen
#
#   Gewaehlt sind 340 mit Sicherheitsabstand.
#
# WARUM ABRUNDEN DIE RICHTIGE RICHTUNG IST
#   Horizont zu GROSS -> der Lauf endet bei einem Vielfachen der Ziellernrate,
#                        das Ergebnis ist UNGUELTIG.
#   Horizont zu KLEIN -> die Lernrate clampt am Minimum. Gueltig, nur weniger
#                        effizient.
#   (numerisch bestaetigt in arc/test_scheduler_horizon.py)
#
# WARUM ALLE DREI ARME DIESELBE ZAHL BEKOMMEN
#   Der Vergleich soll walltime-gematcht sein. Dass SigmaDock je Stunde
#   langsamer ist, fuehrt dann zu weniger ERREICHTEN Epochen -- und genau das
#   gehoert in die Auswertung, statt es durch verschiedene Horizonte zu
#   verstecken.
#
# Benutzung:
#   HORIZON_FILE=arc/final_horizon_kuratiert.env FINAL_WALLTIME=96:00:00 \
#     ... bash arc/submit_final.sh sigmaflow_minimal

export FINAL_N_TRAIN=17685
export FINAL_HORIZON_EFFECTIVE_BATCH=32
export FINAL_HORIZON_POLICY=matched_walltime
export FINAL_HORIZON_THROUGHPUT_SOURCE="ABGELEITET, nicht gemessen: aus Job 8691436 (Rezept-YAML, pb_check aktiv, 348 Epochen in 93,1 h auf 19037 Beispielen = 3,74 Ep/h = 71.200 Beispiele/h). Auf effektive Batch 32 mit 91 % angesetzt (65.000/h), 96 h Walltime, 17.685 Beispiele -> 352 Epochen rechnerisch, 340 gewaehlt. Restunsicherheit rund 10 Prozent; bei Unterschaetzung clampt die Lernrate am Minimum, bei Ueberschaetzung waere der Lauf ungueltig -- deshalb abgerundet."

# 552 Optimiererschritte je Epoche (floor(17685/32)) x 340 = 187680
export FINAL_MAX_EPOCHS_SIGMAFLOW_MINIMAL=340
export FINAL_MAX_STEPS_SIGMAFLOW_MINIMAL=187680

export FINAL_MAX_EPOCHS_SIGMAFLOW_TWOHEAD=340
export FINAL_MAX_STEPS_SIGMAFLOW_TWOHEAD=187680

export FINAL_MAX_EPOCHS_SIGMADOCK=340
export FINAL_MAX_STEPS_SIGMADOCK=187680
