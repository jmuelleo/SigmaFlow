# HORIZONT FAMILIE B: PDBbind v2020.R1, KURATIERT, 96 STUNDEN.
#
# DER DATENSATZ
#   train_exps = [pdbbind-general-kuratiert, pdbbind-refined-kuratiert]
#     general kuratiert  17970   (19037 R1 minus 1067, also 5,60 %)
#     refined kuratiert   5149   (5307 minus 158, also 2,98 %)
#   `MetaFront` dedupliziert NICHT -- refined geht ZWEIMAL in jede Epoche ein,
#   genau wie im publizierten Rezept.
#       FINAL_N_TRAIN = 17970 + 5149 = 23119
#
#   REFINED MUSS MITKURATIERT WERDEN. Wuerde man nur general bereinigen und
#   `pdbbind-refined` unveraendert lassen, kaemen 158 der entfernten Komplexe
#   ueber refined vollstaendig wieder herein und der Lauf waere gar kein
#   kuratierter.
#
# WARUM DIE BEIDEN QUOTEN VERSCHIEDEN SIND
#   refined 2,98 %, general-only 6,62 % (909 von 13.730). Der refined-Satz ist
#   gut doppelt so sauber -- dieselbe Richtung wie der Befund, dass von den
#   406 Komplexen, die PDBbind zwischen v2020 und v2024 aussortiert hat, nur
#   9 im refined-Satz lagen. PDBbinds Qualitaetsfilter und unser
#   PoseBusters-Kriterium sind sich also einig, welche Schicht schlechter ist.
#
# HERKUNFT DES DURCHSATZES -- ABGELEITET, NICHT GEMESSEN
#   Aus Rezeptlauf 8691436: 348 Epochen in 93,1 h auf 19.037 Beispielen, also
#   rund 71.200 Beispiele/h mit aktivem `pb_check`. Angesetzt 65.000/h (91 %).
#
#       96 h x 65.000 / 23.119 = 270 Epochen rechnerisch
#
#   Gewaehlt sind 255, also rund 5,5 % Abstand.
#
# WARUM ABRUNDEN DIE RICHTIGE RICHTUNG IST
#   Horizont zu GROSS -> der Lauf endet bei einem Vielfachen der Ziellernrate,
#                        das Ergebnis ist UNGUELTIG.
#   Horizont zu KLEIN -> die Lernrate clampt am Minimum. Gueltig, nur weniger
#                        effizient.
#   (numerisch bestaetigt in arc/test_scheduler_horizon.py)
#
# WARUM A UND B VERSCHIEDEN VIELE EPOCHEN BEKOMMEN
#   Gematcht wird die WALLTIME, nicht der Fahrplan. B hat kleinere Epochen und
#   bekommt deshalb mehr davon. In Optimiererschritten liegen beide Familien
#   dicht beieinander (185.520 gegen 184.110), was den Vergleich zusaetzlich
#   fair macht -- das ist aber Folge, nicht Ziel.
#
# Benutzung:
#   HORIZON_FILE=arc/final_horizon_B_kuratiert.env FINAL_WALLTIME=96:00:00 \
#     TRAIN_EXPS="pdbbind-general-kuratiert pdbbind-refined-kuratiert" \
#     VAL_EXPS=pdbbind-core EARLY_STOP=50 \
#     bash arc/submit_final.sh sigmaflow_minimal

export FINAL_N_TRAIN=23119
export FINAL_HORIZON_EFFECTIVE_BATCH=32
export FINAL_HORIZON_POLICY=matched_walltime
export FINAL_HORIZON_THROUGHPUT_SOURCE="ABGELEITET, nicht gemessen: aus Job 8691436 (Rezept-YAML, pb_check aktiv, 348 Epochen in 93,1 h auf 19037 Beispielen = 71.200 Beispiele/h). Auf effektive Batch 32 mit 91 % angesetzt (65.000/h), 96 h Walltime, 23.119 Beispiele je Epoche (17970 general-kuratiert + 5149 refined-kuratiert, Doppelzaehlung wie im Original) -> 270 Epochen rechnerisch, 255 gewaehlt (rund 5,5 % Abstand). Restunsicherheit rund 10 Prozent; bei Unterschaetzung clampt die Lernrate am Minimum, bei Ueberschaetzung waere der Lauf ungueltig -- deshalb abgerundet."

# 722 Optimiererschritte je Epoche (floor(23119/32)) x 255 = 184110
export FINAL_MAX_EPOCHS_SIGMAFLOW_MINIMAL=255
export FINAL_MAX_STEPS_SIGMAFLOW_MINIMAL=184110

export FINAL_MAX_EPOCHS_SIGMAFLOW_TWOHEAD=255
export FINAL_MAX_STEPS_SIGMAFLOW_TWOHEAD=184110

export FINAL_MAX_EPOCHS_SIGMADOCK=255
export FINAL_MAX_STEPS_SIGMADOCK=184110
