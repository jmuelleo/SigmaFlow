# HORIZONT FAMILIE A: PDBbind v2020 ORIGINAL, UNKURATIERT, 96 STUNDEN.
#
# DER DATENSATZ
#   train_exps = [pdbbind2020-general, pdbbind2020-refined]
#     general  19443   (5316 refined + 14127 v2020-other-PL, disjunkt geprueft)
#     refined   5316
#   `MetaFront` dedupliziert NICHT, und refined ist Teilmenge von general --
#   diese 5316 gehen also ZWEIMAL in jede Epoche ein. Das ist im publizierten
#   Rezept genauso und wird hier bewusst nachgebildet.
#       FINAL_N_TRAIN = 19443 + 5316 = 24759
#
#   Dies ist der Datensatz aus dem SigmaDock-Paper. Er ist ABSICHTLICH nicht
#   kuratiert; die Kuratierung findet in Familie B statt. A gegen B misst
#   "Datensatz roh gegen bereinigt" bei gleicher Trainingsweise.
#
# HERKUNFT DES DURCHSATZES -- ABGELEITET, NICHT GEMESSEN
#   Wie final_horizon_kuratiert.env: aus Rezeptlauf 8691436, der 348 Epochen
#   in 93,1 h auf 19.037 Beispielen erreichte, also rund 71.200 Beispiele/h
#   MIT aktivem `pb_check`. Angesetzt sind 65.000/h (91 %), weil bei
#   effektiver Batch 32 statt 64 doppelt so viele Optimiererschritte anfallen.
#
#       96 h x 65.000 / 24.759 = 252 Epochen rechnerisch
#
#   Gewaehlt sind 240, also rund 5 % Abstand. Der erste Ansatz mit 250 hatte
#   nur 0,8 % -- zu knapp fuer eine ABGELEITETE Zahl mit rund 10 % Unsicherheit.
#
# WARUM ABRUNDEN DIE RICHTIGE RICHTUNG IST
#   Horizont zu GROSS -> der Lauf endet bei einem Vielfachen der Ziellernrate,
#                        das Ergebnis ist UNGUELTIG.
#   Horizont zu KLEIN -> die Lernrate clampt am Minimum. Gueltig, nur weniger
#                        effizient.
#   (numerisch bestaetigt in arc/test_scheduler_horizon.py)
#
# WARUM A UND B VERSCHIEDEN VIELE EPOCHEN BEKOMMEN
#   Gematcht wird die WALLTIME, nicht der Fahrplan. A hat groessere Epochen
#   (24.759 gegen 23.119), also passen weniger davon in dieselben 96 h. Genau
#   das gehoert in die Auswertung, statt es durch gleiche Epochenzahlen zu
#   verstecken.
#
# Benutzung:
#   HORIZON_FILE=arc/final_horizon_A_original.env FINAL_WALLTIME=96:00:00 \
#     TRAIN_EXPS="pdbbind2020-general pdbbind2020-refined" \
#     VAL_EXPS=pdbbind2020-core EARLY_STOP=50 \
#     bash arc/submit_final.sh sigmaflow_minimal

export FINAL_N_TRAIN=24759
export FINAL_HORIZON_EFFECTIVE_BATCH=32
export FINAL_HORIZON_POLICY=matched_walltime
export FINAL_HORIZON_THROUGHPUT_SOURCE="ABGELEITET, nicht gemessen: aus Job 8691436 (Rezept-YAML, pb_check aktiv, 348 Epochen in 93,1 h auf 19037 Beispielen = 71.200 Beispiele/h). Auf effektive Batch 32 mit 91 % angesetzt (65.000/h), 96 h Walltime, 24.759 Beispiele je Epoche (19443 general + 5316 refined, Doppelzaehlung wie im Original) -> 252 Epochen rechnerisch, 240 gewaehlt (rund 5 % Abstand). Restunsicherheit rund 10 Prozent; bei Unterschaetzung clampt die Lernrate am Minimum, bei Ueberschaetzung waere der Lauf ungueltig -- deshalb abgerundet."

# 773 Optimiererschritte je Epoche (floor(24759/32)) x 240 = 185520
export FINAL_MAX_EPOCHS_SIGMAFLOW_MINIMAL=240
export FINAL_MAX_STEPS_SIGMAFLOW_MINIMAL=185520

export FINAL_MAX_EPOCHS_SIGMAFLOW_TWOHEAD=240
export FINAL_MAX_STEPS_SIGMAFLOW_TWOHEAD=185520

export FINAL_MAX_EPOCHS_SIGMADOCK=240
export FINAL_MAX_STEPS_SIGMADOCK=185520
