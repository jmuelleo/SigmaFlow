# ERZEUGT von arc/calculate_final_epochs.py -- NICHT VON HAND EDITIEREN.
# Diese Datei ist die einzige Quelle des Trainingshorizonts.
# final_config.sh sourced sie; resolve_horizon_for_model() prueft sie
# gegen die aktuelle Batch-Konfiguration und rechnet max_steps nach.
#
# Politik            : matched_walltime
# Durchsatzquelle    : sigmaflow_minimal und sigmadock GEMESSEN: Jobs 8628662/8628663, Stufe-2-Logs, Batch 32, pdbbind-general, TF32. sigmaflow_twohead NICHT gemessen (Sweeps 8638132/8640292 liefen in den Zeitgrenze): abgeleitet aus den 12h-Laeufen, wo EXP-110 mit 0.35147 Schritten/s um 2.1 Prozent SCHNELLER lief als Minimal mit 0.34427 trotz 12.8 Prozent mehr Parametern; konservativ auf Minimals 21.1 gesetzt statt auf die extrapolierten 21.5. Restunsicherheit rund 4 Prozent (Spanne 250-261 Epochen), abgeleitet aus dem Kontrollfall SigmaDock, dessen Rueckstand von 2.0 Prozent bei Batch 8 auf 6.2 Prozent bei Batch 32 waechst. Budget 64h von 72h Walltime.
# Zeitbudget         : 64.0 h reine Optimierung

export FINAL_N_TRAIN=19037
export FINAL_HORIZON_EFFECTIVE_BATCH=32
export FINAL_HORIZON_POLICY=matched_walltime
export FINAL_HORIZON_THROUGHPUT_SOURCE="sigmaflow_minimal und sigmadock GEMESSEN: Jobs 8628662/8628663, Stufe-2-Logs, Batch 32, pdbbind-general, TF32. sigmaflow_twohead NICHT gemessen (Sweeps 8638132/8640292 liefen in den Zeitgrenze): abgeleitet aus den 12h-Laeufen, wo EXP-110 mit 0.35147 Schritten/s um 2.1 Prozent SCHNELLER lief als Minimal mit 0.34427 trotz 12.8 Prozent mehr Parametern; konservativ auf Minimals 21.1 gesetzt statt auf die extrapolierten 21.5. Restunsicherheit rund 4 Prozent (Spanne 250-261 Epochen), abgeleitet aus dem Kontrollfall SigmaDock, dessen Rueckstand von 2.0 Prozent bei Batch 8 auf 6.2 Prozent bei Batch 32 waechst. Budget 64h von 72h Walltime."

