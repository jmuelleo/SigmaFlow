# ERZEUGT von arc/calculate_final_epochs.py -- NICHT VON HAND EDITIEREN.
# Diese Datei ist die einzige Quelle des Trainingshorizonts.
# final_config.sh sourced sie; resolve_horizon_for_model() prueft sie
# gegen die aktuelle Batch-Konfiguration und rechnet max_steps nach.
#
# Politik            : matched_walltime
# Durchsatzquelle    : Jobs 8628662/8628663, Stufe-2-Logs, Fortschrittsanzeige bei Batch 32, pdbbind-general, TF32; Budget 64h von 72h Walltime als Reserve fuer Datafront-Aufbau, Validierung und Messunsicherheit
# Zeitbudget         : 64.0 h reine Optimierung

export FINAL_N_TRAIN=19037
export FINAL_HORIZON_EFFECTIVE_BATCH=32
export FINAL_HORIZON_POLICY=matched_walltime
export FINAL_HORIZON_THROUGHPUT_SOURCE="Jobs 8628662/8628663, Stufe-2-Logs, Fortschrittsanzeige bei Batch 32, pdbbind-general, TF32; Budget 64h von 72h Walltime als Reserve fuer Datafront-Aufbau, Validierung und Messunsicherheit"

# sigmaflow_minimal: 21.100 Beispiele/s, eigenstaendig waeren 255 Epochen moeglich
export FINAL_MAX_EPOCHS_SIGMAFLOW_MINIMAL=255
export FINAL_MAX_STEPS_SIGMAFLOW_MINIMAL=151470
export FINAL_SAMPLES_PER_S_SIGMAFLOW_MINIMAL=21.1000

# sigmadock: 19.800 Beispiele/s, eigenstaendig waeren 239 Epochen moeglich
export FINAL_MAX_EPOCHS_SIGMADOCK=239
export FINAL_MAX_STEPS_SIGMADOCK=141966
export FINAL_SAMPLES_PER_S_SIGMADOCK=19.8000
