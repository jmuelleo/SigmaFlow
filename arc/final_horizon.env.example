# VORLAGE -- diese Datei wird NICHT gelesen.
#
# Die echte Datei heisst arc/final_horizon.env und wird ERZEUGT, nicht
# geschrieben:
#
#   python arc/calculate_final_epochs.py \
#       --arm sigmaflow_minimal --samples-per-s <gemessen> \
#       --arm sigmadock         --samples-per-s <gemessen> \
#       --n-train <gemessen> --physical-batch <gewaehlt> --accum <gewaehlt> \
#       --budget-hours 70 \
#       --throughput-source "job <ID> stage2_*.json" \
#       --write-env arc/final_horizon.env
#
# Alle Zahlen stammen aus dem Stufe-2-Throughput-Lauf. Von Hand eingetragene
# Werte werden von resolve_horizon_for_model() erkannt und abgelehnt, weil
# max_steps gegen floor(n_train/effektive_batch) * max_epochs nachgerechnet
# wird.
#
# Beispielhafter Inhalt (KEINE gueltigen Messwerte):
#
# export FINAL_N_TRAIN=19443
# export FINAL_HORIZON_EFFECTIVE_BATCH=32
# export FINAL_HORIZON_POLICY=same_epochs
# export FINAL_HORIZON_THROUGHPUT_SOURCE="job 0000000"
# export FINAL_MAX_EPOCHS_SIGMAFLOW_MINIMAL=00
# export FINAL_MAX_STEPS_SIGMAFLOW_MINIMAL=00000
# export FINAL_MAX_EPOCHS_SIGMADOCK=00
# export FINAL_MAX_STEPS_SIGMADOCK=00000
